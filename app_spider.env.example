# RapidAPI
RAPIDAPI_BASE_URL=https://app-store-google-play-data-api.p.rapidapi.com
RAPIDAPI_HOST=app-store-google-play-data-api.p.rapidapi.com
RAPIDAPI_KEY=replace_with_your_rapidapi_key
RAPIDAPI_TIMEOUT_SECONDS=20
RAPIDAPI_REQUEST_INTERVAL_MS=300
RAPIDAPI_MONTHLY_BUDGET=30000

# MySQL
MYSQL_HOST=replace_with_your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=appbk
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=appbk
MYSQL_CHARSET=utf8mb4

# Spider defaults
SPIDER_COUNTRIES=cn,us
SPIDER_DEFAULT_LANGUAGE=zh
SPIDER_RANKING_LIMIT=100
SPIDER_MAX_RETRIES=4
SPIDER_LOG_LEVEL=INFO
SPIDER_LOG_FILE=logs/app_spider.log
SPIDER_LOCK_FILE=/tmp/app_spider_daily.lock
